#pragma once

// Copy this file to secrets.h (same folder) and fill in your real values.
// secrets.h is gitignored - it will never be committed, so it's safe to put
// real credentials in it. This .example file IS committed, as a template.

constexpr const char* WIFI_SSID = "YOUR_WIFI_SSID";
constexpr const char* WIFI_PASSWORD = "YOUR_WIFI_PASSWORD";

// Your MQTT broker's LAN IP (or hostname) and port - typically the same
// machine running Home Assistant / Mosquitto. Default Mosquitto port is 1883.
constexpr const char* MQTT_HOST = "192.168.1.10";
constexpr int MQTT_PORT = 1883;

// Leave both as empty strings ("") if your broker allows anonymous
// connections. Most Home Assistant + Mosquitto add-on setups require auth
// by default - if so, fill these in with a dedicated MQTT user (not your HA
// login), which you create under Settings > People > Users in HA, or via
// the Mosquitto add-on's configuration.
constexpr const char* MQTT_USER = "";
constexpr const char* MQTT_PASSWORD_SECRET = "";
